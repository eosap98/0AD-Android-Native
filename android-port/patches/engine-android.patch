 		g_ConfigDB.Get(g_Game && g_Game->IsGameStarted() ? "adaptivefps.session" : "adaptivefps.menu", 0.0)};
 
+#if OS_ANDROID
+	// Use display pacing at the refresh-rate target, and a software deadline
+	// only when VSync is off or the requested limit is below the display rate.
+	static AndroidPerformance::FramePacer framePacer;
